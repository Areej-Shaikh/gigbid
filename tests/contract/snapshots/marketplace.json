  "send_message": {
   "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": false
   },
   "description": "Send a message to a client. Only call after human approval. dry_run defaults to True.",
   "input": {
    "properties": {
     "client_id": {
      "maxLength": 50,
      "minLength": 1,
      "title": "Client Id",
      "type": "string"
     },
     "dry_run": {
      "default": true,
      "title": "Dry Run",
      "type": "boolean"
     },
     "idempotency_key": {
      "maxLength": 100,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
     },
     "job_id": {
      "anyOf": [
       {
        "maxLength": 50,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Job Id"
     },
     "text": {
      "maxLength": 5000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
     }
    },
    "required": [
     "client_id",
     "text",
     "idempotency_key"
    ],
    "title": "send_messageArguments",
    "type": "object"
   },
   "output": {
    "properties": {
     "dry_run": {
      "title": "Dry Run",
      "type": "boolean"
     },
     "message_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Message Id"
     },
     "status": {
      "title": "Status",
      "type": "string"
     },
     "would_send": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Would Send"
     }
    },
    "required": [
     "dry_run",
     "status"
    ],
    "title": "SendResult",
    "type": "object"
   }
  },
  "submit_proposal": {
   "annotations": {
    "destructiveHint": true,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": false
   },
   "description": "Submit an approved draft to the client. SPENDS CONNECTS. Only call after human approval.\n    dry_run defaults to True; a retried call with the same idempotency_key never submits twice.",
   "input": {
    "properties": {
     "draft_id": {
      "maxLength": 50,
      "minLength": 1,
      "title": "Draft Id",
      "type": "string"
     },
     "dry_run": {
      "default": true,
      "description": "True = only preview what would be sent and the cost",
      "title": "Dry Run",
      "type": "boolean"
     },
     "idempotency_key": {
      "maxLength": 100,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
     }
    },
    "required": [
     "draft_id",
     "idempotency_key"
    ],
    "title": "submit_proposalArguments",
    "type": "object"
   },
   "output": {
    "properties": {
     "connects_balance_after": {
      "title": "Connects Balance After",
      "type": "integer"
     },
     "connects_cost": {
      "title": "Connects Cost",
      "type": "integer"
     },
     "dry_run": {
      "title": "Dry Run",
      "type": "boolean"
     },
     "proposal_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Proposal Id"
     },
     "status": {
      "title": "Status",
      "type": "string"
     },
     "would_send": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Would Send"
     }
    },
    "required": [
     "dry_run",
     "connects_cost",
     "connects_balance_after",
     "status"
    ],
    "title": "SubmitResult",
    "type": "object"
   }
  }
