 "tools": {
  "create_proposal_draft": {
   "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
   },
   "description": "Save a proposal as a DRAFT. Nothing is sent to the client. Same idempotency_key returns the same draft.",
   "input": {
    "properties": {
     "bid_amount": {
      "description": "USD; hourly rate or fixed price",
      "exclusiveMinimum": 0,
      "maximum": 100000,
      "title": "Bid Amount",
      "type": "number"
     },
     "cover_letter": {
      "maxLength": 5000,
      "minLength": 50,
      "title": "Cover Letter",
      "type": "string"
     },
     "idempotency_key": {
      "maxLength": 100,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
     },
     "job_id": {
      "maxLength": 50,
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
     },
     "screening_answers": {
      "default": [],
      "items": {
       "maxLength": 3000,
       "type": "string"
      },
      "title": "Screening Answers",
      "type": "array"
     }
    },
    "required": [
     "job_id",
     "cover_letter",
     "bid_amount",
     "idempotency_key"
    ],
    "title": "create_proposal_draftArguments",
    "type": "object"
   },
   "output": {
    "properties": {
     "bid_amount": {
      "title": "Bid Amount",
      "type": "number"
     },
     "connects_cost": {
      "title": "Connects Cost",
      "type": "integer"
     },
     "cover_letter": {
      "title": "Cover Letter",
      "type": "string"
     },
     "draft_id": {
      "title": "Draft Id",
      "type": "string"
     },
     "job_id": {
      "title": "Job Id",
      "type": "string"
     },
     "screening_answers": {
      "items": {
       "type": "string"
      },
      "title": "Screening Answers",
      "type": "array"
     },
     "status": {
      "default": "draft",
      "title": "Status",
      "type": "string"
     }
    },
    "required": [
     "draft_id",
     "job_id",
     "cover_letter",
     "bid_amount",
     "screening_answers",
     "connects_cost"
    ],
    "title": "ProposalDraft",
    "type": "object"
   }
  },
