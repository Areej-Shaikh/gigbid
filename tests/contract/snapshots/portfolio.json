{
 "prompts": [
  "answer_screening_question",
  "best_proof_for_job"
 ],
 "resource_templates": [
  "portfolio://case/{case_id}",
  "portfolio://proposal/{proposal_id}"
 ],
 "tools": {
  "get_case_study": {
   "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
   },
   "description": "Get the full text of one case study (or any evidence item) by id.",
   "input": {
    "properties": {
     "evidence_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Evidence Id",
      "type": "string"
     }
    },
    "required": [
     "evidence_id"
    ],
    "title": "get_case_studyArguments",
    "type": "object"
   },
   "output": {
    "properties": {
     "client_industry": {
      "title": "Client Industry",
      "type": "string"
     },
     "date": {
      "title": "Date",
      "type": "string"
     },
     "evidence_id": {
      "title": "Evidence Id",
      "type": "string"
     },
     "project": {
      "title": "Project",
      "type": "string"
     },
     "skills": {
      "items": {
       "type": "string"
      },
      "title": "Skills",
      "type": "array"
     },
     "source": {
      "title": "Source",
      "type": "string"
     },
     "text": {
      "title": "Text",
      "type": "string"
     },
     "title": {
      "title": "Title",
      "type": "string"
     }
    },
    "required": [
     "evidence_id",
     "title",
     "project",
     "skills",
     "date",
     "client_industry",
     "text",
     "source"
    ],
    "title": "CaseStudy",
    "type": "object"
   }
  },
  "list_skills": {
   "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
   },
   "description": "List the freelancer's skills and how many evidence items support each one.",
   "input": {
    "properties": {},
    "title": "list_skillsArguments",
    "type": "object"
   },
   "output": {
    "$defs": {
     "SkillCount": {
      "properties": {
       "evidence_count": {
        "title": "Evidence Count",
        "type": "integer"
       },
       "skill": {
        "title": "Skill",
        "type": "string"
       }
      },
      "required": [
       "skill",
       "evidence_count"
      ],
      "title": "SkillCount",
      "type": "object"
     }
    },
    "properties": {
     "headline": {
      "title": "Headline",
      "type": "string"
     },
     "hourly_rate": {
      "title": "Hourly Rate",
      "type": "number"
     },
     "persona": {
      "title": "Persona",
      "type": "string"
     },
     "skills": {
      "items": {
       "$ref": "#/$defs/SkillCount"
      },
      "title": "Skills",
      "type": "array"
     }
    },
    "required": [
     "persona",
     "headline",
     "hourly_rate",
     "skills"
    ],
    "title": "SkillList",
    "type": "object"
   }
  },
  "search_evidence": {
   "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
   },
   "description": "Find portfolio evidence (case studies, repos, reviews, past proposals, CV) that proves a requirement.\n    Every claim in a proposal must cite an evidence_id returned here.",
   "input": {
    "properties": {
     "k": {
      "default": 5,
      "maximum": 20,
      "minimum": 1,
      "title": "K",
      "type": "integer"
     },
     "outcomes": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "e.g. ['won','replied'] for past proposals",
      "title": "Outcomes"
     },
     "requirement": {
      "description": "One job requirement, e.g. 'RAG chatbot with citations'",
      "maxLength": 500,
      "minLength": 2,
      "title": "Requirement",
      "type": "string"
     },
     "since": {
      "anyOf": [
       {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "YYYY-MM-DD",
      "title": "Since"
     },
     "types": {
      "anyOf": [
       {
        "items": {
         "enum": [
          "cv",
          "case_study",
          "repo",
          "review",
          "proposal"
         ],
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Only these evidence types",
      "title": "Types"
     }
    },
    "required": [
     "requirement"
    ],
    "title": "search_evidenceArguments",
    "type": "object"
   },
   "output": {
    "$defs": {
     "Evidence": {
      "properties": {
       "client_industry": {
        "title": "Client Industry",
        "type": "string"
       },
       "date": {
        "title": "Date",
        "type": "string"
       },
       "evidence_id": {
        "title": "Evidence Id",
        "type": "string"
       },
       "outcome": {
        "description": "delivered / won / replied / ignored / N stars",
        "title": "Outcome",
        "type": "string"
       },
       "project": {
        "title": "Project",
        "type": "string"
       },
       "score": {
        "title": "Score",
        "type": "number"
       },
       "skills": {
        "items": {
         "type": "string"
        },
        "title": "Skills",
        "type": "array"
       },
       "snippet": {
        "description": "First 400 characters; load the full item with get_case_study or a resource",
        "title": "Snippet",
        "type": "string"
       },
       "source": {
        "title": "Source",
        "type": "string"
       },
       "title": {
        "title": "Title",
        "type": "string"
       },
       "type": {
        "title": "Type",
        "type": "string"
       }
      },
      "required": [
       "evidence_id",
       "type",
       "title",
       "snippet",
       "project",
       "skills",
       "date",
       "client_industry",
       "outcome",
       "source",
       "score"
      ],
      "title": "Evidence",
      "type": "object"
     }
    },
    "properties": {
     "requirement": {
      "title": "Requirement",
      "type": "string"
     },
     "results": {
      "items": {
       "$ref": "#/$defs/Evidence"
      },
      "title": "Results",
      "type": "array"
     },
     "retriever": {
      "title": "Retriever",
      "type": "string"
     }
    },
    "required": [
     "requirement",
     "results",
     "retriever"
    ],
    "title": "EvidenceResults",
    "type": "object"
   }
  }
 }
}
