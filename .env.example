# --- Marketplace ---
MARKETPLACE_MODE=gigsim
GIGSIM_URL=http://127.0.0.1:8001
MARKETPLACE_MCP_PORT=8002
MARKETPLACE_RATE_LIMIT=50
# token:user pairs, comma separated. Use a long random token in .env, NOT this one
MARKETPLACE_MCP_TOKENS=change-me-dev-token:demo
AUDIT_LOG=logs/audit.jsonl

# --- Portfolio ---
PORTFOLIO_PERSONA=ai_ml_engineer
RAG_VARIANT=bm25                  # deployed retriever (docs/adr/0003)

# --- Agents ---
# fake = no LLM, rule-based fallbacks. open = Groq hosted open models. ollama = local.
LLM_PROFILE=fake
GROQ_API_KEY=
OLLAMA_API_KEY=ollama

# --- Web app ---
# users who can sign in: username:password pairs. Put the REVIEWER login only in .env (never commit it)
APP_USERS=demo:demo123
# long random string that signs login tokens: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET=change-me

# --- Persistence ---
# empty = SQLite files in data/processed (local dev). Docker compose and Render set a Postgres URL.
DATABASE_URL=

# --- Tracing (E3) ---
# empty = tracing off. Local Phoenix: http://localhost:6006/v1/traces (docker compose sets this for the API).
# Langfuse Cloud / LangSmith: their OTLP endpoint + auth headers (public trace links for the README).
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
TRACE_URL_TEMPLATE=

# ---- Live Upwork mode (A4): MARKETPLACE_MODE=upwork, then: python scripts/connect_upwork.py --user <you>
# Key that encrypts stored OAuth tokens. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
TOKEN_STORE_PATH=data/processed/oauth_tokens.json
GIGBID_USER=demo                  # whose Upwork tokens the marketplace server uses in live mode

# ---- Worker (E1): scheduled scouting
REDIS_URL=redis://localhost:6379
