# --- Marketplace ---
MARKETPLACE_MODE=gigsim
GIGSIM_URL=http://127.0.0.1:8001
MARKETPLACE_MCP_PORT=8002
MARKETPLACE_RATE_LIMIT=50
# token:user pairs, comma separated. Use a long random token in .env, NOT this one
MARKETPLACE_MCP_TOKENS=change-me-dev-token:demo
AUDIT_LOG=logs/audit.jsonl

# --- Portfolio ---
PORTFOLIO_PERSONA=ai_ml_engineer
RAG_VARIANT=v2_hybrid

# --- Agents ---
# fake = no LLM, rule-based fallbacks. open = Groq hosted open models. ollama = local.
LLM_PROFILE=fake
GROQ_API_KEY=
OLLAMA_API_KEY=ollama

# --- Web app ---
# users who can sign in: username:password pairs. Put the REVIEWER login only in .env (never commit it)
APP_USERS=demo:demo123
# long random string that signs login tokens: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET=change-me
