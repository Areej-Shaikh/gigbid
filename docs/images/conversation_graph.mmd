---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	read_messages(read_messages)
	classify(classify)
	slots(slots)
	draft_reply(draft_reply)
	compliance_msg(compliance_msg)
	preview_msg(preview_msg)
	approve_msg(approve_msg)
	send_msg(send_msg)
	__end__([<p>__end__</p>]):::last
	__start__ --> read_messages;
	approve_msg -. &nbsp;end&nbsp; .-> __end__;
	approve_msg -.-> compliance_msg;
	approve_msg -.-> send_msg;
	classify -.-> draft_reply;
	classify -.-> slots;
	compliance_msg -.-> __end__;
	compliance_msg -.-> preview_msg;
	draft_reply -.-> __end__;
	draft_reply -.-> compliance_msg;
	preview_msg --> approve_msg;
	read_messages -. &nbsp;end&nbsp; .-> __end__;
	read_messages -.-> classify;
	slots --> draft_reply;
	send_msg --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
